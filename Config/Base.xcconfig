#include "Branding.xcconfig"

// Identity (derived from Branding.xcconfig)
PRODUCT_NAME = $(BRAND_NAME)
PRODUCT_MODULE_NAME = MediaCenter
PRODUCT_BUNDLE_IDENTIFIER = $(BRAND_BUNDLE_ID)
MARKETING_VERSION = 0.1.0
CURRENT_PROJECT_VERSION = 1

// Platform
MACOSX_DEPLOYMENT_TARGET = 14.0
SDKROOT = macosx

// Language
SWIFT_VERSION = 6.0
SWIFT_STRICT_CONCURRENCY = complete
SWIFT_UPCOMING_FEATURE_EXISTENTIAL_ANY = YES

// Zero-warning policy
SWIFT_TREAT_WARNINGS_AS_ERRORS = YES
GCC_TREAT_WARNINGS_AS_ERRORS = YES

// App bundle
INFOPLIST_FILE = App/Info.plist
GENERATE_INFOPLIST_FILE = NO
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon
ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME = AccentColor

// Distribution model: hardened runtime, no App Sandbox (see CLAUDE.md)
ENABLE_HARDENED_RUNTIME = YES
ENABLE_APP_SANDBOX = NO
ENABLE_USER_SCRIPT_SANDBOXING = YES

// Local builds are ad-hoc signed; Stage 9 adds Developer ID signing.
CODE_SIGN_STYLE = Manual
CODE_SIGN_IDENTITY = -
DEVELOPMENT_TEAM =
// Needed only because the signature is ad-hoc: see the comment in the file. A Developer ID
// build must use entitlements without the library-validation exception.
CODE_SIGN_ENTITLEMENTS = Config/LocalSigning.entitlements
