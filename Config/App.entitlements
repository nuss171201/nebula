<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  For builds signed with an identity (Scripts/package.sh). Locally built, ad-hoc signed apps
	  use LocalSigning.entitlements, which adds the library-validation exception they need.

	  The watch party's voice chat: the hardened runtime keeps the microphone from an app without this.
	-->
	<key>com.apple.security.device.audio-input</key>
	<true/>
</dict>
</plist>
