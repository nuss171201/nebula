// The single place that defines the app's identity.
// Rename the app by changing these values; nothing else in the repo hard-codes the name.
// The icon lives in App/Assets.xcassets/AppIcon.appiconset (regenerate with Scripts/generate-icon.swift).

BRAND_NAME = Nebula
// The identifier is what the user's library, settings and caches are filed under: changing it
// starts every existing user from nothing. It still carries the app's first working name.
BRAND_BUNDLE_ID = dev.orbit.placeholder.app

// Updates (Sparkle). With both empty, as here, the app has no updater and no "Check for Updates…".
// To switch it on: put the appcast's https address in UPDATE_FEED_URL and the Ed25519 public key
// (from Sparkle's generate_keys tool) in UPDATE_PUBLIC_KEY. Anything else leaves the updater off:
// see UpdateConfiguration. An xcconfig file reads "//" as the start of a comment, so write the
// address as  https:/$()/updates.example.com/appcast.xml
UPDATE_FEED_URL =
UPDATE_PUBLIC_KEY =
